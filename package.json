{
  "name": "gaurav-portfolio",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "release": "standard-version",
    "validate:css": "node scripts/validate-css.js",
    "validate:console": "node scripts/validate-console.js",
    "test:css-fix": "node scripts/test-css-fix.js",
    "pre-deploy": "npm run validate:css && chmod +x scripts/pre-deploy-check.sh && scripts/pre-deploy-check.sh",
    "deploy:vercel": "npm run pre-deploy && vercel --prod",
    "deploy:cloudflare": "npm run pre-deploy && npm run build && npx wrangler pages publish .next",
    "test:first-load": "echo 'Testing first-load reliability...' && curl -I https://www.gauravpatil.online/_next/static/chunks/main.js",
    "test:css": "curl -I https://www.gauravpatil.online/_next/static/css/ 2>/dev/null | grep -i 'content-type.*text/css' && echo 'CSS MIME type: ✅' || echo 'CSS MIME type: ❌'",
    "monitor:metrics": "curl -s https://www.gauravpatil.online/api/monitoring/metrics || echo 'Monitoring endpoint not yet deployed'"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@netlify/next": "^1.4.9",
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.0.0-alpha.8",
    "@sentry/nextjs": "^9.22.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "firebase": "^11.8.1",
    "firebase-admin": "^13.4.0",
    "jose": "^5.2.0",
    "js-cookie": "^3.0.5",
    "mini-svg-data-uri": "^1.4.4",
    "motion": "^12.12.1",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.0.5",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.176.0",
    "three-globe": "^2.42.4",
    "ua-parser-js": "^2.0.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "postcss": "^8.5.3",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
