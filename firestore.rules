// firestore.rules
// Firestore Security Rules for Ask Me Directly Q&A System
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================================================
    // VISITOR TRACKING (Existing rules - preserved)
    // ==================================================
    
    // Visitors collection - allows visitor tracking
    match /visitors/{visitorId} {
      allow read, write: if true; // Open for visitor tracking system
    }
    
    // Ban appeals collection
    match /ban_appeals/{appealId} {
      allow read, write: if true; // Open for appeal system
    }
    
    // AI Assistant questions (existing)
    match /ai_questions/{questionId} {
      allow read: if true; // Public read for predefined questions
      allow write: if request.auth != null && 
                      request.auth.token.admin == true; // Admin only write
    }

    // ==================================================
    // DIRECT QUESTIONS - NEW Q&A SYSTEM
    // ==================================================
    
    // Direct Questions Collection
    match /directQuestions/{questionId} {
      
      // Helper functions
      function isAdmin() {
        return request.auth != null && 
               request.auth.token.admin == true;
      }
      
      function isQuestionOwner() {
        return resource.data.visitorUuid == getVisitorUUID();
      }
      
      function isValidQuestionData() {
        return request.resource.data.keys().hasAll([
          'visitorUuid', 'question', 'status', 'createdAt', 
          'updatedAt', 'metadata'
        ]) &&
        request.resource.data.visitorUuid is string &&
        request.resource.data.question is string &&
        request.resource.data.question.size() >= 10 &&
        request.resource.data.question.size() <= 500 &&
        request.resource.data.status in ['unanswered', 'answered', 'archived'] &&
        request.resource.data.metadata is map;
      }
      
      function getVisitorUUID() {
        // Extract UUID from cookie or request context
        // This is a simplified version - actual implementation may vary
        return request.headers['x-visitor-uuid'] != null ? 
               request.headers['x-visitor-uuid'] : '';
      }
      
      // CREATE: Allow visitors to create questions for themselves
      allow create: if isValidQuestionData() &&
                       request.resource.data.visitorUuid == getVisitorUUID() &&
                       request.resource.data.status == 'unanswered' &&
                       request.resource.data.adminReply == null &&
                       request.resource.data.answeredAt == null &&
                       request.resource.data.unreadForVisitor == false;
      
      // READ: Visitors can read their own questions, admins can read all
      allow read: if isAdmin() || 
                     (resource.data.visitorUuid == getVisitorUUID());
      
      // UPDATE: 
      // - Visitors can only mark their questions as read (unreadForVisitor = false)
      // - Admins can update any field
      allow update: if isAdmin() ||
                       (isQuestionOwner() && 
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['unreadForVisitor', 'updatedAt', 'readAt']) &&
                        request.resource.data.unreadForVisitor == false);
      
      // DELETE: Admin only (soft delete by changing status to archived)
      allow delete: if isAdmin();
    }

    // ==================================================
    // VISITOR METADATA COLLECTION (for question context)
    // ==================================================
    
    match /visitorMetadata/{visitorId} {
      allow read, write: if request.auth != null && 
                            request.auth.token.admin == true; // Admin only
      allow create: if visitorId == getVisitorUUID(); // Visitors can create their own metadata
    }

    // ==================================================
    // ADMIN COLLECTIONS
    // ==================================================
    
    // Admin activity logs
    match /adminLogs/{logId} {
      allow read, write: if request.auth != null && 
                            request.auth.token.admin == true;
    }
    
    // System configuration
    match /systemConfig/{configId} {
      allow read: if true; // Public read for system status
      allow write: if request.auth != null && 
                      request.auth.token.admin == true;
    }

    // ==================================================
    // HELPER FUNCTIONS (Global)
    // ==================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidTimestamp(timestamp) {
      return timestamp is timestamp;
    }
    
    function isValidString(str, minLen, maxLen) {
      return str is string && 
             str.size() >= minLen && 
             str.size() <= maxLen;
    }

    // ==================================================
    // DEFAULT DENY
    // ==================================================
    
    // Deny access to all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ==================================================
// DEPLOYMENT NOTES
// ==================================================
// 
// 1. Deploy rules: firebase deploy --only firestore:rules
// 
// 2. Required indexes (create via Firebase Console or CLI):
//    - directQuestions: visitorUuid ASC, createdAt DESC
//    - directQuestions: status ASC, createdAt DESC  
//    - directQuestions: visitorUuid ASC, status ASC
//    - directQuestions: createdAt DESC (single field)
//    - directQuestions: updatedAt DESC (single field)
// 
// 3. Custom claims setup for admin users:
//    In Firebase Auth, set custom claim: { admin: true }
//    
// 4. Visitor UUID tracking:
//    Ensure visitor UUID is passed in request headers or
//    available through authentication context
//
// 5. Test security rules thoroughly before production deployment
//