            "visitors": "array",
            "count": "number"
          }
        }
      }
    },
    "banVisitor": {
      "endpoint": "/api/visitor-analytics/ban",
      "methods": {
        "POST": {
          "adminOnly": true,
          "requiredFields": ["mask"],
          "schema": {
            "mask": {
              "type": "string",
              "required": true
            },
            "reason": {
              "type": "string",
              "optional": true
            },
            "bannedBy": {
              "type": "string",
              "optional": true,
              "default": "admin"
            },
            "duration": {
              "type": "string",
              "enum": ["permanent", "1hour", "1day", "1week", "1month"],
              "optional": true,
              "default": "permanent"
            }
          },
          "response": {
            "success": "boolean",
            "message": "string",
            "visitor": "object"
          }
        }
      }
    },
    "unbanVisitor": {
      "endpoint": "/api/visitor-analytics/unban",
      "methods": {
        "POST": {
          "adminOnly": true,
          "requiredFields": ["mask"],
          "schema": {
            "mask": {
              "type": "string",
              "required": true
            }
          },
          "response": {
            "success": "boolean",
            "message": "string",
            "visitor": "object"
          }
        }
