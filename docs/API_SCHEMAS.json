    "contactSubmissions": {
      "endpoint": "/api/contact-submissions",
      "collection": "contactSubmissions",
      "readOnlyForAdmin": true,
      "rateLimits": {
        "perEmail": "3 per 24 hours",
        "perIP": "5 per hour"
      },
      "methods": {
        "GET": {
          "adminOnly": true,
          "response": {
            "success": "boolean",
            "submissions": "array",
            "count": "number"
          }
        },
        "DELETE": {
          "adminOnly": true,
          "queryParams": {
            "id": {
              "type": "string",
              "required": true
            }
          },
          "response": {
            "success": "boolean",
            "message": "string"
          }
        }
      }
    },
    "bugReports": {
      "endpoint": "/api/bug-reports",
      "collection": "bugReports",
      "rateLimits": {
        "perEmail": "3 per 24 hours",
        "perIP": "5 per hour"
      },
      "methods": {
        "GET": {
          "queryParams": {
            "id": {
              "type": "string",
              "optional": true,
              "description": "Get single report by ID"
            }
          },
          "response": {
            "success": "boolean",
            "bugReports or bugReport": "array or object",
            "count": "number (when fetching all)"
          }
        },
        "PUT": {
          "adminOnly": true,
          "requiredFields": ["id"],
          "schema": {
            "id": {
              "type": "string",
              "required": true
            },
            "status": {
              "type": "string",
              "enum": ["new", "in-progress", "resolved", "duplicate", "wont-fix"],
              "optional": true
            },
            "adminNotes": {
              "type": "array",
              "items": {
                "note": "string",
                "createdBy": "string",
                "createdAt": "ISO date string"
              },
              "optional": true
            },
            "assignedTo": {
              "type": "string",
              "optional": true
            },
            "resolvedBy": {
              "type": "string",
              "optional": true
            },
            "duplicateOf": {
              "type": "string",
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "bugReport": "object",
            "message": "string"
          }
        },
        "DELETE": {
          "adminOnly": true,
          "queryParams": {
            "id": {
              "type": "string",
              "required": true
            }
          },
          "response": {
            "success": "boolean",
            "message": "string"
          }
        }
      }
    },
    "bubbleSessions": {
      "endpoint": "/api/bubble/sessions",
      "collection": "og_uuid_sessions",
      "methods": {
        "GET": {
          "queryParams": {
            "allSessions": {
              "type": "string",
              "enum": ["true", "false"],
              "optional": true,
              "description": "Admin: get all sessions"
            },
            "mask": {
              "type": "string",
              "optional": true,
              "description": "Visitor: get session by mask"
            },
            "fingerprint": {
              "type": "string",
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "sessions or session": "array or object"
          }
        },
        "POST": {
          "requiredFields": ["mask"],
          "schema": {
            "mask": {
              "type": "string",
              "required": true,
              "description": "Visitor's session mask"
            },
            "role": {
              "type": "string",
              "enum": ["visitor", "admin"],
              "optional": true,
              "default": "visitor"
            }
          },
          "response": {
            "success": "boolean",
            "session": "object"
          }
        }
      }
    },
    "bubbleMessages": {
      "endpoint": "/api/bubble/messages",
      "collection": "bubbleMessages",
      "rateLimits": {
        "poll": "60 per minute",
        "send": "30 per minute"
      },
      "methods": {
        "GET": {
          "queryParams": {
            "sessionId": {
              "type": "string",
              "required": true,
              "description": "Session UUID"
            },
            "role": {
              "type": "string",
              "enum": ["visitor", "admin"],
              "optional": true
            },
            "limit": {
              "type": "number",
              "optional": true,
              "default": 50
            },
            "fingerprint": {
              "type": "string",
              "optional": true
            }
          },
          "response": {
            "messages": "array",
            "hasMore": "boolean",
            "totalCount": "number",
            "adminTyping": "boolean",
            "visitorTyping": "boolean",
            "adminLastSeen": "ISO date string or null",
            "visitorLastSeen": "ISO date string or null",
            "adminOnline": "boolean",
            "visitorOnline": "boolean",
            "visitorUnread": "number",
            "adminUnread": "number"
          }
        },
        "POST": {
          "requiredFields": ["sessionId", "role", "content"],
          "schema": {
            "sessionId": {
              "type": "string",
              "required": true,
              "description": "Session UUID"
            },
            "role": {
              "type": "string",
              "enum": ["visitor", "admin"],
              "required": true
            },
            "content": {
              "type": "string",
              "required": true,
              "minLength": 1
            },
            "visitorEmail": {
              "type": "string",
              "optional": true
            },
            "fingerprint": {
              "type": "string",
              "optional": true
            },
            "turnstileToken": {
              "type": "string",
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "message": "object"
          }
        },
        "PUT": {
          "requiredFields": ["messageId", "role"],
          "schema": {
            "messageId": {
              "type": "string",
              "required": true,
              "description": "Message custom UUID"
            },
            "role": {
              "type": "string",
              "enum": ["visitor", "admin"],
              "required": true,
              "description": "Reader role"
            }
          },
          "response": {
            "success": "boolean",
            "message": "string"
          }
        }
      }
    },
