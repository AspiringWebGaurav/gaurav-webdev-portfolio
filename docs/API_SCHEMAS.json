              "maxItems": 10,
              "optional": true
            },
            "link": {
              "type": "string",
              "format": "url",
              "optional": true
            },
            "order": {
              "type": "number",
              "min": 1,
              "max": 10,
              "optional": true
            },
            "isActive": {
              "type": "boolean",
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "project": "object",
            "message": "string"
          }
        },
        "DELETE": {
          "queryParams": {
            "id": {
              "type": "string",
              "required": true,
