{
  "apiSchemas": {
    "techStacks": {
      "endpoint": "/api/tech-stacks",
      "collection": "portfolio_techStacks",
      "maxItems": 20,
      "methods": {
        "GET": {
          "queryParams": {
            "admin": {
              "type": "string",
              "enum": ["true", "false"],
              "optional": true,
              "description": "Include inactive items"
            }
          },
          "response": {
            "success": "boolean",
            "items": "array",
            "count": "number"
          }
        },
        "POST": {
          "requiredFields": ["name"],
          "schema": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 30,
              "required": true
            },
            "order": {
              "type": "number",
              "optional": true,
              "autoAssigned": true
            },
            "isActive": {
              "type": "boolean",
              "optional": true,
              "default": true
            }
          },
          "response": {
            "success": "boolean",
            "item": "object",
            "message": "string"
          }
        },
        "PUT": {
          "requiredFields": ["id"],
          "schema": {
            "id": {
              "type": "string",
              "required": true
            },
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 30,
              "optional": true
            },
            "order": {
              "type": "number",
              "optional": true
            },
            "isActive": {
              "type": "boolean",
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "item": "object",
            "message": "string"
          }
        },
        "DELETE": {
          "queryParams": {
            "id": {
              "type": "string",
              "required": true
            },
            "soft": {
              "type": "string",
              "enum": ["true", "false"],
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "message": "string"
          }
        }
      }
    },
