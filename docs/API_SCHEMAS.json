          "requiredFields": ["quote", "name", "title"],
          "acceptsArray": true,
          "schema": {
            "quote": {
              "type": "string",
              "minLength": 20,
              "maxLength": 500,
              "required": true
            },
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 50,
              "required": true
            },
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "required": true
            },
            "img": {
              "type": "string",
              "format": "url",
              "optional": true
            },
            "order": {
              "type": "number",
              "optional": true,
              "autoAssigned": true
            },
            "isActive": {
              "type": "boolean",
              "optional": true,
              "default": true
            }
          },
          "response": {
            "success": "boolean",
            "testimonials": "object or array",
            "message": "string"
          }
        },
        "PUT": {
          "requiredFields": ["id"],
          "schema": {
            "id": {
              "type": "string",
              "required": true
            },
            "quote": {
              "type": "string",
              "minLength": 20,
              "maxLength": 500,
              "optional": true
            },
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 50,
              "optional": true
            },
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "optional": true
            },
            "img": {
              "type": "string",
              "format": "url",
              "optional": true
            },
            "order": {
              "type": "number",
              "optional": true
            },
            "isActive": {
              "type": "boolean",
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "testimonial": "object",
            "message": "string"
          }
        },
        "DELETE": {
          "queryParams": {
            "id": {
              "type": "string",
              "required": true
            },
            "soft": {
              "type": "string",
              "enum": ["true", "false"],
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "message": "string"
          }
        }
      }
    },
