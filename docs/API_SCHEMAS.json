            },
            "answer": {
              "type": "string",
              "required": true
            },
            "order": {
              "type": "number",
              "optional": true,
              "default": 0
            }
          },
          "response": {
            "success": "boolean",
            "question": "object"
          }
        },
        "PUT": {
          "adminOnly": true,
          "requiredFields": ["id"],
          "schema": {
            "id": {
              "type": "string",
              "required": true
            },
            "question": {
              "type": "string",
              "optional": true
            },
            "answer": {
              "type": "string",
              "optional": true
            },
            "order": {
              "type": "number",
              "optional": true
            },
            "active": {
              "type": "boolean",
              "optional": true
            }
          },
          "response": {
            "success": "boolean"
          }
        },
        "DELETE": {
          "adminOnly": true,
          "queryParams": {
            "questionId": {
              "type": "string",
              "required": true
            },
            "permanent": {
              "type": "string",
              "enum": ["true", "false"],
              "optional": true
            }
          },
          "response": {
            "success": "boolean"
          }
        }
      }
    },
    "visitorAnalytics": {
      "endpoint": "/api/visitor-analytics/visitors",
      "collection": "og_uuid_visitorProfiles",
