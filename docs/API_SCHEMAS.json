            },
            "soft": {
              "type": "string",
              "enum": ["true", "false"],
              "optional": true
            }
          },
          "response": {
            "success": "boolean",
            "message": "string"
          }
        }
      }
    },
    "testimonials": {
      "endpoint": "/api/testimonials",
      "collection": "portfolio_testimonials",
      "maxItems": 20,
      "supportsBatchCreate": true,
      "methods": {
        "GET": {
          "response": {
            "success": "boolean",
