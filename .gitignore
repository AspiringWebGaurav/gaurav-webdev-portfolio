# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables (NEVER commit these)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.vercel

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Scripts directory (contains sensitive setup guides)
/scripts

# Backups directory (contains Firebase database & storage backups)
/backups

# Ignore Firebase service account credentials and config files
serviceAccountKey.json
firebaseConfig.json

# Ignore any JSON files with credentials or keys in the name
*credential*.json
*secret*.json
*private*.json

# Backup and temporary files
*.bak
*.backup
*.old
*_OLD.*
test-output.txt

# Test results and coverage
test-results/
coverage/
*.log
